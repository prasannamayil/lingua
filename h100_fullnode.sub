request_cpus = 64
request_gpus = 8
request_memory = 500000
request_disk = 300G
requirements = (CUDADeviceName == "NVIDIA H100 80GB HBM3")
log_root = /is/cluster/fast/twiedemer/jobs/$(ClusterId)
error = $(log_root).err
output = $(log_root).out
log = $(log_root).log
MaxTime = 1555200
periodic_remove = (JobStatus =?= 2) && ((CurrentTime - JobCurrentStartDate) >= $(MaxTime))
queue
